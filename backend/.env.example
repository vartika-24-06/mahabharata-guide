# Copy to backend/.env and fill in real values. Never commit .env itself
# (already in .gitignore).

# Our own server-side embeddings key (never the visitor's) - see
# docs/hosting-notes.md section 8 and design.md Property 4.
OPENAI_API_KEY=

# Supabase project (pgvector) - see backend/supabase_schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Signs the opaque session token issued by POST /api/session-token
# (entry-screen spec). Any long random string - generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_TOKEN_SECRET=
